---
// Clearview homepage — V3b "Clear View" (approved mockup, 2026-11-17:
// client-docs/homepage-mockups/v3b-clear-view.html). Rendered by both
// src/pages/index.astro (English) and src/pages/es/index.astro (Spanish);
// all copy comes from src/data/home-copy.ts.
//
// Sections: full-bleed hero that fades into the navy quick-links bar (a paw
// trail walks across it) → about → numbered service index → meet the doctor
// (paw pattern) → why choose us → reviews (paw pattern) → visit (hours + map).
import { Image } from "astro:assets";
import { getSiteInfo } from "../../lib/data/site";
import { getHomeDoctors } from "../../lib/data/doctors";
import { getAllTestimonials } from "../../lib/data/testimonials";
import { phoneHref } from "../../lib/utils/phone";
import { homeCopy } from "../../data/home-copy";
import { type Lang, routes } from "../../data/i18n";
import avatarGeneric from "../../assets/avatar-generic.png";
import heroImg from "../../assets/home/hero-german-shepherd.jpg";
import aboutImg from "../../assets/home/about-lab-and-cat.jpg";
import aboutImg2 from "../../assets/home/about-small-dog.jpg";
import teamImg from "../../assets/home/clearview-team.jpg";
import svcWellness from "../../assets/home/svc-wellness.jpg";
import svcDental from "../../assets/home/svc-dental.jpg";
import svcSurgery from "../../assets/home/svc-surgery.jpg";
import svcUrgent from "../../assets/home/svc-urgent.jpg";
import erVeg from "../../assets/home/emergency/veg.png";
import erFetch from "../../assets/home/emergency/fetch.png";
import erUpstate from "../../assets/home/emergency/upstate-vet.png";

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = homeCopy[lang];
const site = await getSiteInfo();
const doctor = (await getHomeDoctors())[0];
const [featured, ...sideReviews] = await getAllTestimonials();
const svcImages = { wellness: svcWellness, dental: svcDental, surgery: svcSurgery, urgent: svcUrgent };
const arrow = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';

// Hours, built from site.openingHoursSpecification (the same data the schema uses).
type Range = { opens: string; closes: string };
const dayNames = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
const week: Range[][] = dayNames.map((name) =>
  (site.openingHoursSpecification ?? [])
    .filter((s) => s.dayOfWeek.includes(name))
    .map(({ opens, closes }) => ({ opens, closes }))
    .sort((a, b) => a.opens.localeCompare(b.opens))
);
const fmt = (hhmm: string) => {
  const [h, m] = hhmm.split(":").map(Number);
  return `${h % 12 || 12}${m ? `:${String(m).padStart(2, "0")}` : ""}${h < 12 ? "am" : "pm"}`;
};
const span = (ranges: Range[]) => `${fmt(ranges[0].opens)}–${fmt(ranges[ranges.length - 1].closes)}`;
const rows: { label: string; days: number[]; value: string }[] = [];
for (const d of [1, 2, 3, 4, 5]) rows.push({ label: c.days[d], days: [d], value: week[d].length ? span(week[d]) : c.closed });
// Saturday: open two Saturdays a month, call for hours (Pastel 4wq5nl74 #1).
rows.push({ label: c.days[6], days: [6], value: week[6].length ? span(week[6]) : c.saturdayValue });
rows.push({ label: c.days[0], days: [0], value: week[0].length ? span(week[0]) : c.closed });

// Doctor: monogram until a real headshot replaces the generic avatar.
const hasHeadshot = doctor?.data.mainImage && doctor.data.mainImage.src !== avatarGeneric.src;
const initials = doctor ? doctor.data.name.replace(/^Dr\.?\s*/, "").split(/\s+/).map((w: string) => w[0]).join("").slice(0, 2) : "";
const bookHref = site.bookingUrl || "/contact-us";
---

<section class="hero">
  <Image class="hero__bg" src={heroImg} alt={c.heroImageAlt} widths={[640, 960, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
  {/* Hero video (client, 2026-11-18) plays over the photo; the photo stays as
      the still for loading and for reduced-motion visitors (video removed). */}
  <video class="hero__bg hero__video" src="/video/hero.mp4" autoplay muted loop playsinline preload="auto" aria-hidden="true" data-hero-video></video>
  <div class="hero__inner">
    <div class="hero__copy">
      <p class="eyebrow hero__eyebrow">{c.heroEyebrow}</p>
      <h1 class="hero__title">{c.heroTitle} <span class="accent">{c.heroAccent}</span></h1>
      <p class="hero__lede">{c.heroLede}</p>
      <div class="hero__actions">
        <a class="btn btn--cta" href={bookHref}>{c.bookAppointment} <Fragment set:html={arrow} /></a>
        {site.phoneNumber && <a class="btn btn--line-light" href={phoneHref(site)}>{c.call} <span class="nowrap">{site.phoneNumber}</span></a>}
      </div>
      <p class="hero__today" data-today data-lang={lang} data-hours={JSON.stringify(week)}><i aria-hidden="true"></i><span>{c.hoursFallback}</span></p>
    </div>
  </div>
  {/* Pastel 4wq5nl74 #5 (2026-11-25): the "Since 1958" seal became a call button. */}
  {site.phoneNumber && <a class="hero__seal" href={phoneHref(site)}><span>{c.sealCta}</span></a>}
</section>

<div class="band">
  <div class="band__inner"><div class="trail" data-trail aria-hidden="true"></div></div>
  <ul class="band__inner quick">
    {c.quick.map((q) => (
      <li>
        <a class="quick__link" href={q.href === "BOOKING" ? bookHref : q.href} {...(q.external || q.href === "BOOKING" ? { target: "_blank", rel: "noopener" } : {})}>
          <span class="quick__tag">{q.tag}</span>
          <b class="quick__title">{q.title}</b>
          <span class="quick__text">{q.text}</span>
        </a>
      </li>
    ))}
  </ul>
</div>

<section class="sec about">
  <div class="wrap about__grid">
    <div class="about__stack" data-reveal="left">
      <Image class="about__img" src={aboutImg} alt={c.aboutImageAlt} widths={[480, 720, 960]} sizes="(max-width: 900px) 82vw, 40vw" />
      <Image class="about__img about__img--small" src={aboutImg2} alt="" widths={[320, 480]} sizes="(max-width: 900px) 45vw, 22vw" />
    </div>
    <div data-reveal>
      <p class="eyebrow">{c.aboutEyebrow}</p>
      <h2 class="sec__title">{c.aboutTitle} <span class="accent">{c.aboutAccent}</span></h2>
      <p class="about__text">{c.aboutText}</p>
      <a class="btn btn--line" href={routes[lang].team}>{c.meetTeam} <Fragment set:html={arrow} /></a>
    </div>
  </div>
</section>

<section class="sec services">
  <div class="wrap">
    <div class="services__head" data-reveal>
      <div>
        <p class="eyebrow">{c.servicesEyebrow}</p>
        <h2 class="sec__title">{c.servicesTitle} <span class="accent">{c.servicesAccent}</span></h2>
      </div>
      <a class="btn btn--cta" href={routes[lang].services}>{c.allServices} <Fragment set:html={arrow} /></a>
    </div>
    <ol class="svc-list" data-reveal-stagger>
      {c.services.map((s, i) => (
        <li data-reveal>
          <a class="svc" href={s.href === "TEL" ? phoneHref(site) : s.href}>
            <span class="svc__n">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="svc__title">{s.title}</h3>
            <p class="svc__text">{s.text}</p>
            <span class="svc__thumb"><Image src={svcImages[s.image]} alt="" widths={[240, 360]} sizes="180px" /></span>
          </a>
        </li>
      ))}
    </ol>
    <ul class="chips" data-reveal>
      {c.moreServices.map((m) => <li>{m}</li>)}
    </ul>
  </div>
</section>

{doctor && (
  <section class="sec doc paws paws--warm">
    <div class="wrap doc__grid">
      <div class="doc__portrait" data-reveal="left">
        <div class="doc__arch">
          {hasHeadshot && doctor.data.mainImage ? (
            <Image src={doctor.data.mainImage} alt={doctor.data.imageAltText || doctor.data.name} widths={[360, 540]} sizes="(max-width: 900px) 340px, 440px" />
          ) : (
            <span class="doc__mono" aria-hidden="true">{initials}</span>
          )}
        </div>
        {!hasHeadshot && <span class="doc__soon">{c.headshotSoon}</span>}
      </div>
      <div data-reveal>
        <p class="eyebrow">{c.doctorEyebrow}</p>
        <h2 class="sec__title doc__name">{lang === "es" ? doctor.data.name.replace(/^Dr\./, "Dra.") : doctor.data.name}</h2>
        <p class="doc__role">{c.doctorRole}</p>
        <div class="doc__bio" set:html={c.doctorBio ?? doctor.data.bio ?? doctor.data.bioShort ?? ""} />
        <div class="doc__actions">
          <a class="btn btn--cta" href={bookHref}>{c.bookAppointment} <Fragment set:html={arrow} /></a>
          <a class="btn btn--line" href={`/doctors/${doctor.id}`}>{c.readBio(doctor.data.shortName || doctor.data.name)}</a>
        </div>
        <a class="team" href={routes[lang].team}>
          <Image class="team__img" src={teamImg} alt={c.teamImageAlt} widths={[320, 480, 640]} sizes="(max-width: 560px) 90vw, 220px" />
          <span class="team__copy">
            <b>{c.teamTitle}</b>
            <span>{c.teamText}</span>
            <span class="team__more">{c.meetTeam} →</span>
          </span>
        </a>
      </div>
    </div>
  </section>
)}

<section class="sec why">
  <div class="wrap">
    <div class="why__top" data-reveal>
      <div>
        <p class="eyebrow">{c.whyEyebrow}</p>
        <h2 class="sec__title">{c.whyTitle} <span class="accent">{c.whyAccent}</span></h2>
      </div>
      <p>{c.whyText}</p>
    </div>
    <ul class="facts" data-reveal-stagger>
      {c.facts.map((f) => (
        <li class="fact" data-reveal>
          <span class="fact__stat">{f.stat}</span>
          <b>{f.title}</b>
          <span class="fact__text">{f.text}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

{featured && (
  <section class="sec reviews paws paws--warm">
    <div class="wrap reviews__grid">
      <figure class="reviews__featured" data-reveal>
        <p class="eyebrow">{c.reviewsEyebrow}</p>
        <span class="stars" aria-label="5 stars">★★★★★</span>
        <blockquote class:list={["reviews__quote", { "reviews__quote--long": featured.data.testimonial.length > 160 }]} lang="en"><p>{featured.data.testimonial}</p></blockquote>
        <figcaption class="reviews__who">{featured.data.name} <span>· {c.reviewSource}</span></figcaption>
      </figure>
      <div class="reviews__side" data-reveal-stagger>
        {sideReviews.map((r) => (
          <figure class="side-q" data-reveal>
            <span class="stars" aria-label="5 stars">★★★★★</span>
            <blockquote lang="en"><p>“{r.data.testimonial}”</p></blockquote>
            <figcaption class="reviews__who">{r.data.name} <span>· Google</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}

<section class="er" id="emergency" aria-labelledby="er-title">
  {/* Two bands, as on the current site (2026-11-18): red "Emergencies", then
      navy "After Hours Emergencies" with the partner ER logos. Old copy word for word. */}
  <div class="er__now">
    <div class="wrap" data-reveal>
      <h2 class="er__title" id="er-title">{c.erTitle}</h2>
      <p>{c.erHoursBefore} <a href={phoneHref(site)}>{site.phoneNumber}</a>{lang === "es" ? "." : ""}</p>
      <p>{c.erLine}</p>
    </div>
  </div>
  <div class="er__after paws paws--light">
    <div class="wrap er__after-grid" data-reveal>
      <div>
        <h2 class="er__title">{c.erAfterTitle}</h2>
        <p>{c.erAfterText}</p>
      </div>
      <ul class="er__logos" role="list">
        {[
          { href: "https://upstatevet.com/", img: erUpstate, name: "Upstate Veterinary Specialists" },
          { href: "https://fetchvets.com/greenville-sc/", img: erFetch, name: "FETCH Greenville" },
          { href: "https://veterinaryemergencygroup.com/lp/greenville/", img: erVeg, name: "Veterinary Emergency Group (Greenville)" },
        ].map((er) => (
          <li><a href={er.href} target="_blank" rel="noopener"><Image src={er.img} alt={er.name} widths={[260, 520]} sizes="13rem" /></a></li>
        ))}
      </ul>
    </div>
  </div>
</section>

<section class="sec visit" id="visit">
  <div class="wrap visit__grid">
    <div data-reveal>
      <p class="eyebrow visit__eyebrow">{c.visitEyebrow}</p>
      <h2 class="sec__title">{c.visitTitle} <span class="accent">{c.visitAccent}</span></h2>
      <p class="visit__addr">
        {site.address}, {site.addressLine2}<br />
        {site.phoneNumber && <a class="nowrap visit__phone" href={phoneHref(site)}>{site.phoneNumber}</a>}
        {site.email && <> · <a href={`mailto:${site.email}`}>{site.email}</a></>}
      </p>
      <table class="hours" data-hours-table>
        <tbody>
          {rows.map((r) => (
            <tr data-days={r.days.join(" ")}><td>{r.label}<span class="hours__today"> · {c.today}</span></td><td>{r.value}</td></tr>
          ))}
        </tbody>
      </table>
      <p class="visit__small">{c.saturdays} {c.afterHours}</p>
      <div class="visit__actions">
        <a class="btn btn--cta" href={bookHref}>{c.bookNow}</a>
        {site.addressLink && <a class="btn btn--line-light" href={site.addressLink} target="_blank" rel="noopener">{c.directions}</a>}
      </div>
    </div>
    {site.mapEmbedLink && (
      <div class="visit__map" data-reveal="right">
        <iframe title={c.mapTitle} src={site.mapEmbedLink.replace("hl=en", `hl=${lang}`)} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    )}
  </div>
</section>

<script>
  import { homeCopy } from "../../data/home-copy";
  import type { Lang } from "../../data/i18n";

  // "Open now" pill + today's row in the hours table (Easley = Eastern time).
  const pill = document.querySelector<HTMLElement>("[data-today]");
  if (pill) {
    const c = homeCopy[(pill.dataset.lang as Lang) || "en"];
    const week: { opens: string; closes: string }[][] = JSON.parse(pill.dataset.hours || "[]");
    const now = new Date(new Date().toLocaleString("en-US", { timeZone: "America/New_York" }));
    const d = now.getDay();
    const mins = now.getHours() * 60 + now.getMinutes();
    const toMin = (t: string) => { const [h, m] = t.split(":").map(Number); return h * 60 + m; };
    const fmt = (t: string) => { const [h, m] = t.split(":").map(Number); return `${h % 12 || 12}${m ? `:${String(m).padStart(2, "0")}` : ""}${h < 12 ? "am" : "pm"}`; };
    const today = week[d] || [];
    const current = today.find((r) => mins >= toMin(r.opens) && mins < toMin(r.closes));
    const label = pill.querySelector("span");
    if (label && week.length) {
      if (d === 6 && !today.length) {
        label.textContent = c.saturdayPill;
      } else if (current) {
        label.textContent = c.openUntil(fmt(today[today.length - 1].closes));
        pill.classList.add("is-open");
      } else if (today.length && mins < toMin(today[today.length - 1].closes)) {
        label.textContent = c.closedNowOpensToday(`${fmt(today[0].opens)}–${fmt(today[today.length - 1].closes)}`);
      } else {
        for (let i = 1; i <= 7; i++) {
          const next = week[(d + i) % 7];
          if (next?.length) { label.textContent = c.closedTodayNext(c.days[(d + i) % 7], fmt(next[0].opens)); break; }
        }
      }
    }
    document.querySelectorAll<HTMLElement>("[data-hours-table] tr").forEach((tr) => {
      if ((tr.dataset.days || "").split(" ").includes(String(d))) tr.classList.add("is-today");
    });
  }

  // Hero video fades in once it's actually playing; reduced motion keeps the photo.
  const heroVideo = document.querySelector<HTMLVideoElement>("[data-hero-video]");
  if (heroVideo) {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) heroVideo.remove();
    else {
      const show = () => heroVideo.classList.add("is-playing");
      // The first frame advancing is the reliable "it's really playing" signal
      // (autoplay can start before this script runs, so "playing" may be missed).
      if (!heroVideo.paused && heroVideo.currentTime > 0) show();
      else heroVideo.addEventListener("timeupdate", show, { once: true });
    }
  }

  // Paw trail on the navy bar: prints step in one by one (left → right,
  // alternating left/right paws), the trail holds, then they step out one by
  // one in the same order and at the same pace, and the walk repeats.
  // Reduced motion: the prints just sit there, no animation.
  const trail = document.querySelector<HTMLElement>("[data-trail]");
  if (trail) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const paw = '<svg viewBox="0 0 24 24"><ellipse cx="12" cy="16" rx="5.2" ry="4.4"/><ellipse cx="5.2" cy="10.2" rx="2.1" ry="2.7" transform="rotate(-25 5.2 10.2)"/><ellipse cx="9.4" cy="5.8" rx="2.1" ry="2.8" transform="rotate(-8 9.4 5.8)"/><ellipse cx="14.6" cy="5.8" rx="2.1" ry="2.8" transform="rotate(8 14.6 5.8)"/><ellipse cx="18.8" cy="10.2" rx="2.1" ry="2.7" transform="rotate(25 18.8 10.2)"/></svg>';
    const STEP = 0.18, POP = 0.35, HOLD = 1.2, PAUSE = 0.8;
    const build = () => {
      const w = trail.clientWidth, gap = w < 600 ? 44 : 58, n = Math.max(0, Math.floor((w - 30) / gap));
      const outAt = n * STEP + HOLD, D = outAt + n * STEP + PAUSE;
      const pc = (s: number) => `${((s / D) * 100).toFixed(2)}%`;
      let style = document.getElementById("paw-trail-kf");
      if (!style) { style = document.createElement("style"); style.id = "paw-trail-kf"; document.head.appendChild(style); }
      style.textContent =
        `@keyframes paw-step{0%{opacity:0;transform:var(--r) scale(.5)}${pc(POP * 0.6)}{opacity:.7;transform:var(--r) scale(1.08)}${pc(POP)}{opacity:.6;transform:var(--r) scale(1)}` +
        `${pc(outAt)}{opacity:.6;transform:var(--r) scale(1)}${pc(outAt + POP * 0.4)}{opacity:.7;transform:var(--r) scale(1.08)}${pc(outAt + POP)},100%{opacity:0;transform:var(--r) scale(.5)}}`;
      let html = "";
      for (let i = 0; i < n; i++) {
        const up = i % 2 === 0, y = (up ? 14 : 40) + Math.round(Math.sin(i / 3) * 6), rot = 90 + (up ? -8 : 8);
        const anim = reduce ? "opacity:.5" : `opacity:0;animation:paw-step ${D.toFixed(2)}s ${(i * STEP).toFixed(2)}s infinite both`;
        html += paw.replace("<svg", `<svg style="left:${10 + i * gap}px;top:${y}px;--r:rotate(${rot}deg);transform:rotate(${rot}deg);${anim}"`);
      }
      trail.innerHTML = html;
    };
    build();
    let t: number | undefined;
    window.addEventListener("resize", () => { clearTimeout(t); t = window.setTimeout(build, 200); });
  }
</script>

<style>
  .wrap { inline-size: min(var(--container-max), 100% - 2.5rem); margin-inline: auto; }
  .nowrap { white-space: nowrap; }
  /* overflow-x: clip keeps left/right reveals (which start off to the side) from
     widening the page on phones. */
  .sec { padding-block: 6rem; background: var(--surface-warm); overflow-x: clip; }
  .sec__title { font-size: var(--font-size-section); margin: 0; }

  /* --- Hero: full-bleed photo, navy scrim on the text side, bottom fades into the bar --- */
  .hero { position: relative; overflow: hidden; display: flex; align-items: center; min-block-size: min(84vh, 46rem); padding-block: calc(var(--header-height) + 4rem) 5rem; margin-block-end: -1px; color: var(--white); }
  .hero :global(.hero__bg) { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; object-fit: cover; object-position: 70% 30%; }
  .hero .hero__video.hero__bg { object-position: 50% 50%; opacity: 0; transition: opacity var(--motion-duration-slow) var(--motion-ease); }
  .hero .hero__video.is-playing { opacity: 1; }
  .hero::after { content: ""; position: absolute; inset: 0; background:
      linear-gradient(180deg, var(--main-transparent) 55%, var(--hero-fade-mid) 78%, var(--main) 96%, var(--main) 100%),
      linear-gradient(90deg, var(--hero-scrim) 0%, var(--hero-scrim-mid) 38%, var(--hero-scrim-light) 70%, var(--dark-transparent) 100%); }
  .hero__inner { position: relative; z-index: 1; inline-size: min(var(--container-max), 100% - 2.5rem); margin-inline: auto; }
  .hero__copy { max-inline-size: 42rem; }
  .hero__eyebrow { color: var(--accent-soft); }
  .hero__title { color: var(--white); font-size: var(--font-size-display); margin: 0 0 var(--space-lg); }
  .hero__title .accent { display: block; color: var(--accent-soft); }
  .hero__lede { font-size: 1.2rem; color: var(--white-o85); max-inline-size: 36ch; margin: 0 0 var(--space-xl); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-sm); margin-block-end: var(--space-xl); }
  .hero__today { display: inline-flex; align-items: center; gap: var(--space-sm); margin: 0; background: var(--white); color: var(--main); border-radius: var(--radius-pill); padding: 0.55rem 1.1rem 0.55rem 0.8rem; font-size: 0.93rem; font-weight: 600; }
  .hero__today i { inline-size: 10px; block-size: 10px; border-radius: 50%; background: var(--text-muted); }
  .hero__today.is-open i { background: var(--status-open); box-shadow: 0 0 0 5px var(--status-open-ring); }
  .hero__seal { position: absolute; z-index: 1; inset-inline-end: 6%; inset-block-end: 2.6rem; inline-size: 128px; block-size: 128px; border-radius: 50%; background: var(--main); border: 3px solid var(--white); color: var(--white); display: grid; place-items: center; text-align: center; line-height: 1.05; transform: rotate(-8deg); box-shadow: var(--shadow-float); }
  .hero__seal { inline-size: 168px; block-size: 168px; padding: 1.4rem; font-weight: 700; font-size: 0.98rem; line-height: 1.2; transition: background-color var(--motion-duration-base) var(--motion-ease), transform var(--motion-duration-base) var(--motion-ease); }
  .hero__seal:hover, .hero__seal:focus-visible { background: var(--cta); color: var(--white); transform: rotate(-8deg) scale(1.04); }

  /* --- Navy bar: paw trail + quick links --- */
  .band { background: var(--main); color: var(--white); }
  .band__inner { inline-size: min(var(--container-max), 100% - 2.5rem); margin-inline: auto; }
  .trail { position: relative; block-size: 64px; overflow: hidden; }
  .trail :global(svg) { position: absolute; inline-size: 24px; block-size: 24px; fill: var(--accent-soft); }
  .quick { list-style: none; margin-block: 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); }
