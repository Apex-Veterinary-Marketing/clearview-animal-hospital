---
// Sitewide fixed header — Clearview V3b (approved mockup, 2026-11-17).
//
// A navy utility bar (phone left; EN/ES switch + Book Now right — moved up
// 2026-11-18 so the main row isn't crowded), then one row on warm cream:
// logo and the menu centered in the space beside it. Menu labels that need
// two lines (Spanish "Para Dueños de Mascotas") wrap with centered text. The
// social icons live in the footer. --header-height covers both rows.
//
// Kept from the template: the dynamic Services flyout (one submenu per
// service category), the About dropdown's fixed slot (Meet the Team, Photo
// Gallery, How'd We Do? — the only way to open the reputation widget), and
// the slide-out panel at ≤900px. Desktop flyouts taller than the room below
// them are capped and scroll (agency rule, same code as Pacific Grove /
// Wild Magnolia).
import { getSiteInfo } from "../lib/data/site";
import { getAllServiceCategories } from "../lib/data/serviceCategories";
import { getServicesByCategory } from "../lib/data/services";
import { phoneHref } from "../lib/utils/phone";
import { BLOG_BASE } from "../lib/data/blog";
import { type Lang, ui, routes, serviceCategoryEs, PHARMACY_URL, PET_RECORDS_URL, RX_REFILL_URL, PETPAGE_APP_URL } from "../data/i18n";
import { getEsSlugMap, getAllServicesEs, ES_SERVICES_BASE } from "../lib/data/servicesEs";

interface Props {
  lang?: Lang;
  /** Where the switch's other-language button goes (BaseLayout computes it). */
  altHref?: string;
}
const { lang = "en", altHref = lang === "es" ? "/" : "/es/" } = Astro.props;
const t = ui[lang];
const r = routes[lang];
const es = lang === "es";
const esSlugs = es ? await getEsSlugMap() : {};
const esNames = es ? Object.fromEntries((await getAllServicesEs()).map((s) => [s.data.enSlug, s.data.name])) : {};
const serviceHref = (id: string) => (es && esSlugs[id] ? `${ES_SERVICES_BASE}/${esSlugs[id]}/` : `/services/${id}`);

const site = await getSiteInfo();
const categories = await getAllServiceCategories();
const servicesByCategory = await Promise.all(
  categories.map(async (category) => ({
    category,
    services: await getServicesByCategory(category.id),
  }))
);
// The 404 page has no real path of its own, so its "current language" link goes home.
const here = /^\/(es\/)?404/.test(Astro.url.pathname) ? t.home : Astro.url.pathname;
const enHref = lang === "en" ? here : altHref;
const esHref = lang === "es" ? here : altHref;
---

<header class="header" data-header>
  <div class="header__topbar">
    <div class="header__topbar-inner">
      {site.phoneNumber && (
        <a class="header__phone" href={phoneHref(site)} aria-label={`${t.callUs} ${site.phoneNumber}`}>
          <svg class="header__phone-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg>
          <span>{site.phoneNumber}</span>
        </a>
      )}
      <ul class="header__badges">
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8 12.2 2.7 2.7L16.2 9.4"/></svg>{t.acceptingPatients}</li>
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M4 9.5h16M8.5 3v4M15.5 3v4m-6 8 1.8 1.8 3.4-3.4"/></svg>{t.sameDay}</li>
      </ul>
      <div class="header__actions">
        <div class="header__lang" role="group" aria-label={t.language}>
          <svg class="header__lang-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.6 2.5 3.9 5.5 3.9 9s-1.3 6.5-3.9 9c-2.6-2.5-3.9-5.5-3.9-9S9.4 5.5 12 3z"/></svg>
          <a class="header__lang-option" href={enHref} hreflang="en" lang="en" aria-current={lang === "en" ? "true" : undefined}>EN</a>
          <a class="header__lang-option" href={esHref} hreflang="es" lang="es" aria-current={lang === "es" ? "true" : undefined}>ES</a>
        </div>
        {site.bookingUrl && <a class="btn btn--cta header__cta" href={site.bookingUrl}>{lang === "es" ? t.bookNow : site.bookingLabel || t.bookNow}</a>}
      </div>
    </div>
  </div>
  <div class="header__inner">
    <button class="header__menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="primary-menu">
      <span class="header__menu-toggle-bar" aria-hidden="true"></span>
      <span class="header__menu-toggle-bar" aria-hidden="true"></span>
      <span class="header__menu-toggle-bar" aria-hidden="true"></span>
      <span class="sr-only">{t.menu}</span>
    </button>

    <a class="header__logo" href={t.home} aria-label={site.practiceName}>
      {site.logoColor ? (
        <img class="header__logo-image" src={site.logoColor} alt={site.practiceName} width="1200" height="304" />
      ) : (
        <span class="header__logo-text">{site.practiceName}</span>
      )}
    </a>

    <nav class="header__nav" aria-label="Primary">
      <ul class="header__menu" id="primary-menu" data-menu>
        <li class="header__menu-item header__menu-item--dropdown">
          <button class="header__menu-link header__dropdown-toggle" type="button" data-dropdown-toggle aria-expanded="false">
            <span>{t.about}</span> <span class="header__caret" aria-hidden="true"></span>
          </button>
          {/* Fixed slot (Meet the Team, gallery, How'd We Do?). Clearview's
              launch sheet puts "Virtual Tour" in the gallery's place; it is
              hidden until the client's photos/video arrive (2026-11-17) —
              add `<li><a href="/virtual-tour">` here then. */}
          <ul class="header__dropdown-menu">
            <li><a href={r.team}>{t.meetTeam}</a></li>
            <li><button type="button" class="header__dropdown-link-button" data-modal-target="reputation-widget">{t.howdWeDo}</button></li>
          </ul>
        </li>

        <li class="header__menu-item header__menu-item--dropdown">
          <button class="header__menu-link header__dropdown-toggle" type="button" data-dropdown-toggle aria-expanded="false">
            <span>{t.services}</span> <span class="header__caret" aria-hidden="true"></span>
          </button>
          <ul class="header__dropdown-menu header__dropdown-menu--services">
            {servicesByCategory.map(({ category, services }) => (
              <li class="header__dropdown-item header__dropdown-item--has-submenu">
                <button type="button" class="header__submenu-toggle" data-dropdown-toggle aria-expanded="false">
                  {es ? serviceCategoryEs[category.id] ?? category.data.name : category.data.name} <span class="header__caret header__caret--side" aria-hidden="true"></span>
                </button>
                <ul class="header__submenu">
                  {services.map((service) => (
                    <li><a href={serviceHref(service.id)}>{es ? esNames[service.id] ?? service.data.customName ?? service.data.name : service.data.customName || service.data.name}</a></li>
                  ))}
                </ul>
              </li>
            ))}
            <li class="header__dropdown-item header__dropdown-item--all"><a href={r.services}>{t.allServices}</a></li>
          </ul>
        </li>

        <li class="header__menu-item header__menu-item--dropdown">
          <button class="header__menu-link header__dropdown-toggle" type="button" data-dropdown-toggle aria-expanded="false">
            <span>{t.forPetOwners}</span> <span class="header__caret" aria-hidden="true"></span>
          </button>
          <ul class="header__dropdown-menu">
            <li><a href="/faq">{t.faq}</a></li>
            <li><a href={BLOG_BASE}>{t.blog}</a></li>
            <li><a href="/online-forms">{t.forms}</a></li>
            <li><a href={r.payment}>{t.paymentPlans}</a></li>
            <li><a href={PET_RECORDS_URL} target="_blank" rel="noopener">{t.petRecords}</a></li>
            <li><a href={RX_REFILL_URL} target="_blank" rel="noopener">{t.rxRefill}</a></li>
            <li><a href={PETPAGE_APP_URL} target="_blank" rel="noopener">{t.petPageApp}</a></li>
          </ul>
        </li>

        <li class="header__menu-item"><a class="header__menu-link" href={r.events}>{t.events}</a></li>
        <li class="header__menu-item"><a class="header__menu-link" href={PHARMACY_URL} target="_blank" rel="noopener">{t.pharmacy}</a></li>
        <li class="header__menu-item"><a class="header__menu-link" href={r.contact}>{t.contact}</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 50;
    --header-bg: var(--surface-warm);
    --header-fg: var(--main);
    background: var(--header-bg);
    color: var(--header-fg);
    transition: box-shadow var(--motion-duration-slow) var(--motion-ease);
  }
  .header.is-scrolled { box-shadow: var(--shadow-header); }

  /* Navy utility bar: phone left, EN|ES + booking right (2026-11-18). */
  .header__topbar { background: var(--main); color: var(--on-main); }
  .header__topbar-inner { max-width: var(--container-max); margin-inline: auto; block-size: var(--topbar-height); padding-inline: var(--space-lg); display: flex; align-items: center; justify-content: space-between; gap: var(--space-md); }

  .header__inner { max-width: var(--container-max); margin-inline: auto; min-block-size: var(--header-row-height); padding-inline: var(--space-lg); display: flex; align-items: center; gap: var(--space-lg); }

  .header__logo { display: inline-flex; flex-shrink: 0; color: inherit; }
  .header__logo-image { display: block; block-size: var(--logo-height); inline-size: auto; }
  .header__logo-text { font-weight: 700; font-size: var(--font-size-lg); }

  .header__nav { flex: 1; display: flex; justify-content: center; }
  .header__menu { display: flex; align-items: center; gap: var(--space-lg); list-style: none; margin: 0; padding: 0; }
  .header__menu-link { background: none; border: 0; font: inherit; font-weight: 600; font-size: 0.95rem; color: inherit; cursor: pointer; display: inline-flex; align-items: center; gap: 0.35em; padding: var(--space-xs) 0; text-align: center; line-height: 1.25; transition: color var(--motion-duration-fast) var(--motion-ease); }
  .header__menu-link > span:first-child { inline-size: max-content; max-inline-size: 9.5em; }
  .header__menu-link:hover, .header__menu-link[aria-expanded="true"] { color: var(--cta); }
  .header__caret { flex-shrink: 0; inline-size: 0.45em; block-size: 0.45em; border-inline-end: 2px solid currentColor; border-block-end: 2px solid currentColor; transform: rotate(45deg); margin-block-start: -0.2em; }
  .header__caret--side { transform: rotate(-45deg); margin-block-start: 0; }

  .header__menu-item--dropdown { position: relative; }
  .header__dropdown-menu { position: absolute; inset-block-start: calc(100% + var(--space-xs)); inset-inline-start: 50%; translate: -50% 0; min-width: 13rem; background: var(--white); border-radius: var(--radius-lg); box-shadow: var(--shadow-dropdown); list-style: none; margin: 0; padding: var(--space-xs) 0; display: none; z-index: 10; }
  .header__menu-item--dropdown:has(> [aria-expanded="true"]) > .header__dropdown-menu { display: block; }
  .header__dropdown-menu a,
  .header__dropdown-link-button { display: block; width: 100%; text-align: start; padding: var(--space-xs) var(--space-md); color: var(--text); background: none; border: 0; font: inherit; cursor: pointer; }
  .header__dropdown-menu a:hover,
  .header__dropdown-link-button:hover { background: var(--solid-bg); color: var(--main); }
  .header__dropdown-item--all { border-block-start: 1px solid var(--light-grey); margin-block-start: var(--space-xs); padding-block-start: var(--space-xs); }
  .header__dropdown-item--all a { font-weight: 600; color: var(--main); }

  .header__dropdown-item--has-submenu { position: relative; }
  .header__submenu-toggle { display: flex; width: 100%; align-items: center; justify-content: space-between; gap: 0.5em; padding: var(--space-xs) var(--space-md); background: none; border: 0; font: inherit; color: var(--text); cursor: pointer; text-align: start; }
  .header__submenu-toggle:hover { background: var(--solid-bg); }
  .header__submenu { position: absolute; inset-inline-start: 100%; inset-block-start: calc(-1 * var(--space-xs)); min-width: 13rem; background: var(--white); border-radius: var(--radius-lg); box-shadow: var(--shadow-dropdown); list-style: none; margin: 0; padding: var(--space-xs) 0; display: none; }
  .header__submenu-toggle[aria-expanded="true"] + .header__submenu { display: block; }
  .header__submenu a { display: block; padding: var(--space-xs) var(--space-md); color: var(--text); }
  .header__submenu a:hover { background: var(--solid-bg); color: var(--main); }
  .header__dropdown-menu.is-capped, .header__submenu.is-capped { overflow-y: auto; overscroll-behavior: contain; }

  .header__badges { display: flex; align-items: center; gap: var(--space-xl); list-style: none; margin: 0 auto; padding: 0; font-size: 0.88rem; font-weight: 700; white-space: nowrap; }
  .header__badges li { display: inline-flex; align-items: center; gap: 0.5em; }
  .header__badges svg { inline-size: 18px; block-size: 18px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0; }
  @media (max-width: 1100px) { .header__badges { display: none; } }
  .header__actions { display: flex; align-items: center; gap: var(--space-sm); flex-shrink: 0; margin-inline-start: auto; }
  .header__lang { display: inline-flex; align-items: center; gap: 0.1rem; border: 1px solid var(--on-main-line); border-radius: var(--radius-pill); padding: 0.12rem 0.15rem 0.12rem 0.5rem; }
  .header__lang-icon { inline-size: 14px; block-size: 14px; fill: none; stroke: currentColor; stroke-width: 1.8; margin-inline-end: 0.2rem; opacity: 0.85; }
  .header__lang-option { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.04em; color: var(--on-main-muted); padding: 0.2rem 0.55rem; border-radius: var(--radius-pill); transition: background-color var(--motion-duration-base) var(--motion-ease), color var(--motion-duration-base) var(--motion-ease); }
  .header__lang-option:hover { color: var(--white); }
  .header__lang-option[aria-current="true"] { background: var(--white); color: var(--main); }
  .header__phone { display: inline-flex; align-items: center; gap: 0.45em; font-weight: 700; font-size: 0.9rem; color: var(--on-main); white-space: nowrap; }
  .header__phone:hover { color: var(--white); opacity: 0.85; }
  .header__phone-icon { inline-size: 15px; block-size: 15px; fill: currentColor; }
  .header__cta { padding: 0.45rem 1.1rem; font-size: 0.85rem; }

  .header__menu-toggle { display: none; flex-direction: column; gap: 4px; background: none; border: 0; cursor: pointer; padding: var(--space-xs); color: inherit; }
  .header__menu-toggle-bar { width: 22px; height: 2px; background: currentColor; display: block; }

  @media (max-width: 1280px) {
    .header__inner { gap: var(--space-md); }
    .header__menu { gap: var(--space-md); }
  }

  @media (max-width: 900px) {
    .header__inner { padding-inline: var(--space-md); gap: var(--space-sm); }
    .header__menu-toggle { display: inline-flex; }
    .header__logo { margin-inline-end: auto; }
    .header__nav { flex: 0; }
    /* Slide-out panel: a solid sheet below the header bar. */
    .header__menu { position: fixed; inset-block-start: var(--header-height); inset-inline: 0; inset-block-end: 0; background: var(--white); flex-direction: column; align-items: stretch; gap: 0; padding: var(--space-md) var(--space-lg) var(--space-2xl); overflow-y: auto; transform: translateX(-100%); transition: transform var(--motion-duration-slow) var(--motion-ease); border-block-start: 1px solid var(--light-grey); }
    .header__menu.is-open { transform: translateX(0); }
    .header__menu > li { border-block-end: 1px solid var(--light-grey); }
    .header__menu-link { inline-size: 100%; justify-content: space-between; padding-block: var(--space-sm); font-size: var(--font-size-lg); text-align: start; color: var(--main); }
    .header__menu-link > span:first-child { max-inline-size: none; }
    .header__dropdown-menu, .header__submenu { position: static; translate: none; box-shadow: none; border-radius: 0; padding: 0 0 var(--space-sm) var(--space-md); min-width: 0; }
    .header__caret--side { transform: rotate(45deg); margin-block-start: -0.25em; }
  }

  @media (max-width: 520px) {
    .header__inner, .header__topbar-inner { gap: var(--space-xs); padding-inline: var(--space-sm); }
    /* Phones: the call bar already dials, so the top bar keeps EN|ES + booking. */
    .header__phone { display: none; }
    .header__cta { padding: 0.4rem 0.9rem; font-size: 0.8rem; }
  }
  @media (max-width: 380px) {
    .header__logo-image { block-size: 1.85rem; }
  }
</style>

<script>
  const header = document.querySelector("[data-header]");
  function updateHeaderScrollState() {
    header?.classList.toggle("is-scrolled", window.scrollY > 10);
  }
  updateHeaderScrollState();
  window.addEventListener("scroll", updateHeaderScrollState, { passive: true });

  // Desktop flyouts taller than the space below them get capped to it and
  // scroll (.is-capped), so every item stays reachable on short screens.
  // The Services list itself is never capped: scrolling it would clip the
  // category flyouts that open beside it. Same fix as Pacific Grove.
  const desktopNav = window.matchMedia("(min-width: 901px)");
  function fitToViewport(menu: Element | null) {
    if (!(menu instanceof HTMLElement) || menu.matches(".header__dropdown-menu--services")) return;
    menu.style.maxBlockSize = "";
    menu.classList.remove("is-capped");
    if (!desktopNav.matches) return;
    const room = window.innerHeight - menu.getBoundingClientRect().top - 16;
    if (menu.scrollHeight > room) {
      menu.style.maxBlockSize = `${Math.max(room, 160)}px`;
      menu.classList.add("is-capped");
    }
  }
  window.addEventListener("resize", () => {
    document.querySelectorAll('[data-dropdown-toggle][aria-expanded="true"]').forEach((btn) => fitToViewport(btn.nextElementSibling));
  });

  document.addEventListener("click", (e) => {
    if (!(e.target instanceof Element)) return;

    const menuToggle = e.target.closest("[data-menu-toggle]");
    if (menuToggle) {
      const menu = document.querySelector("[data-menu]");
      const expanded = menuToggle.getAttribute("aria-expanded") === "true";
      menuToggle.setAttribute("aria-expanded", String(!expanded));
      menu?.classList.toggle("is-open", !expanded);
      return;
    }

    const dropdownToggle = e.target.closest("[data-dropdown-toggle]");
    if (dropdownToggle) {
      const expanded = dropdownToggle.getAttribute("aria-expanded") === "true";
      const parentList = dropdownToggle.parentElement?.parentElement;
      parentList?.querySelectorAll(":scope > li > [data-dropdown-toggle]").forEach((btn) => {
        if (btn !== dropdownToggle) btn.setAttribute("aria-expanded", "false");
      });
      dropdownToggle.setAttribute("aria-expanded", String(!expanded));
      if (!expanded) requestAnimationFrame(() => fitToViewport(dropdownToggle.nextElementSibling));
      return;
    }

    if (!e.target.closest(".header__menu-item--dropdown")) {
      document.querySelectorAll('[data-dropdown-toggle][aria-expanded="true"]').forEach((btn) => btn.setAttribute("aria-expanded", "false"));
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      document.querySelectorAll('[data-dropdown-toggle][aria-expanded="true"]').forEach((btn) => btn.setAttribute("aria-expanded", "false"));
    }
  });
</script>
