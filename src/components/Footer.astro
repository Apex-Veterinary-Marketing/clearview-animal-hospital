---
// Generalized from the real V2 Webflow export's footer.html: accordion
// columns (native <details>/<summary>, zero JS) that collapse only on
// mobile.
//
// Restructured 2026-09-17 back toward the real export's actual 5-column
// layout (About us / Services / Dental Care / Surgery / Resources) —
// previously Skeleton had generalized Dental/Surgery away into one
// dynamic "Services" column (see git history); direct instruction to
// restore the dedicated per-category columns. Dental/Surgery are matched
// by category id ("dental"/"surgery" — Skeleton's own example category
// slugs, the same ones services-categories/[slug].astro already routes
// on) rather than hardcoded names, and each column disappears gracefully
// if a client doesn't have that category (getServiceCategoryBySlug
// returns undefined) — same "only render what's configured" pattern as
// ReputationWidget's review links. "Services" (general) lists every
// service NOT in Dental or Surgery, so a client's Wellness Care (or any
// future third category) still surfaces somewhere.
//
// About Us column also absorbed what used to be its own "Follow Us"
// column — logo, ~160-char footerAbout blurb, the existing About Us
// links, then the social icons — direct instruction, freeing up the
// column slot the Dental/Surgery split needed.
import { getSiteInfo } from "../lib/data/site";
import { getAllServiceCategories } from "../lib/data/serviceCategories";
import { getAllSocialLinks } from "../lib/data/socialLinks";
import { SOCIAL_ICON_CLASSES, SOCIAL_LABELS } from "../lib/icons/social";
import { BLOG_BASE } from "../lib/data/blog";
import ReviewsBand from "./ReviewsBand.astro";
import { type Lang, ui, routes, serviceCategoryEs, PHARMACY_URL } from "../data/i18n";
import { phoneHref } from "../lib/utils/phone";
import { ES_SERVICES_BASE } from "../lib/data/servicesEs";

interface Props { lang?: Lang }
const { lang = "en" } = Astro.props;
const t = ui[lang];
const es = lang === "es";

const site = await getSiteInfo();
const socialLinks = await getAllSocialLinks();
const year = new Date().getFullYear();

const categories = await getAllServiceCategories();
const r = routes[lang];
const servicesBase = es ? `${ES_SERVICES_BASE}/` : "/services";
// Patient links from the launch sheet's footer list (the client's current site).
const patientLinks = [
  { label: es ? "Historial de Mascotas" : "Pet Records", href: "https://practices.allydvm.com?practice=clearviewanimal" },
  { label: es ? "Solicitud de Cita" : "Appointment Request", href: site.bookingUrl || "https://practices.allydvm.com/online-booking?practice=clearviewanimal" },
  { label: es ? "Resurtido de Recetas" : "Rx Refill Request", href: "https://practices.allydvm.com/product-request?practice=clearviewanimal" },
  { label: es ? "App PetPage" : "PetPage App", href: r.app }, // app page (Pastel 4wq5nl74 #6)
  { label: es ? "Farmacia en Línea" : "Online Pharmacy", href: PHARMACY_URL },
];
---

<footer class="footer">
  {/* Fixed-position floating pill (desktop only) — not in-flow footer content, see ReviewsBand.astro. */}
  <ReviewsBand lang={lang} />

  <div class="footer__grid">
    <details class="footer__column footer__column--about" open>
      <summary class="footer__column-title">{es ? "Nosotros" : "About Us"}</summary>
      <div class="footer__about">
        {site.logoWhite || site.logoColor ? (
          <img class="footer__logo" src={site.logoWhite || site.logoColor} alt={site.practiceName} />
        ) : (
          <span class="footer__logo-text">{site.practiceName}</span>
        )}
        {site.footerAbout && <p class="footer__about-text">{es ? "El Hospital de Animales Clearview brinda atención veterinaria personal y compasiva a perros, gatos y otros miembros peludos de la familia en Easley, SC y toda la región." : site.footerAbout}</p>}
        <ul class="footer__link-list">
          <li><a href={r.team}>{t.meetTeam}</a></li>
          <li><button type="button" class="footer__link-button" data-modal-target="reputation-widget">{t.howdWeDo}</button></li>
        </ul>
        <div class="footer__social-icons">
          {socialLinks.map((social) => (
            <a
              class="footer__social-icon"
              href={social.data.link}
              aria-label={SOCIAL_LABELS[social.data.icon]}
              target="_blank"
              rel="noopener noreferrer"
            >
              <i class={SOCIAL_ICON_CLASSES[social.data.icon]} aria-hidden="true"></i>
            </a>
          ))}
        </div>
      </div>
    </details>

    <details class="footer__column" open>
      <summary class="footer__column-title">{t.services}</summary>
      <ul class="footer__link-list">
        {categories.map((c) => (
          <li><a href={`${servicesBase}#${c.id}`}>{es ? serviceCategoryEs[c.id] ?? c.data.name : c.data.name}</a></li>
        ))}
        <li><a href={servicesBase}><strong>{t.allServices}</strong></a></li>
      </ul>
    </details>

    <details class="footer__column" open>
      <summary class="footer__column-title">{es ? "Para Pacientes" : "For Patients"}</summary>
      <ul class="footer__link-list">
        {patientLinks.map((l) => <li><a href={l.href} {...(l.href.startsWith("http") ? { target: "_blank", rel: "noopener" } : {})}>{l.label}</a></li>)}
      </ul>
    </details>

    <details class="footer__column" open>
      <summary class="footer__column-title">{es ? "Recursos" : "Resources"}</summary>
      <ul class="footer__link-list">
        <li><a href="/faq">{t.faq}</a></li>
        <li><a href={BLOG_BASE}>{t.blog}</a></li>
        <li><a href="/online-forms">{t.forms}</a></li>
        <li><a href={r.payment}>{t.paymentPlans}</a></li>
        <li><a href={r.events}>{t.events}</a></li>
        <li><a href={r.privacy}>{es ? "Política de Privacidad y Términos" : "Privacy Policy & Terms"}</a></li>
      </ul>
    </details>

    <details class="footer__column" open>
      <summary class="footer__column-title">{es ? "Visítenos" : "Visit Us"}</summary>
      <address class="footer__visit">
        {site.address && <span>{site.address}<br />{site.addressLine2}</span>}
        {site.phoneNumber && <a class="footer__phone" href={phoneHref(site)}>{site.phoneNumber}</a>}
        {site.email && <a href={`mailto:${site.email}`}>{site.email}</a>}
        <a class="footer__contact-link" href={r.contact}>{es ? "Horario y cómo llegar" : "Hours & directions"} →</a>
      </address>
    </details>
  </div>

  <div class="footer__bottom">
    <p class="footer__copyright">&copy; {year} {site.practiceName}. {t.rights}</p>
    <a class="footer__signature" href="https://veterinarymarketing.com/" target="_blank" rel="noopener noreferrer">
      {es ? "Hecho con" : "Made with"} &hearts; {es ? "por" : "by"} Veterinary Marketing
    </a>
  </div>
</footer>

<style>
  .footer { background: var(--footer-bg); color: var(--footer-text); padding-block-start: var(--space-2xl); }
  .footer__grid { inline-size: min(var(--container-max), 100% - 2.5rem); margin-inline: auto; display: grid; grid-template-columns: 1.3fr repeat(4, 1fr); gap: var(--space-xl); }
  .footer__visit { display: flex; flex-direction: column; gap: var(--space-xs); margin-block-start: var(--space-sm); font-style: normal; }
  .footer__visit a { color: inherit; }
  .footer__visit a:hover { color: var(--accent-soft); }
  .footer__visit .footer__phone { font-weight: 700; white-space: nowrap; color: var(--white); }
  .footer__visit .footer__contact-link { font-weight: 700; color: var(--accent-soft); }
  .footer__column { border-block-end: 1px solid var(--footer-border); padding-block-end: var(--space-sm); }
  .footer__column-title { font-weight: 700; font-size: var(--font-size-md); color: var(--footer-heading); cursor: default; padding-block: var(--space-xs); }
  .footer__link-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-xs); margin-block-start: var(--space-sm); }
  .footer__link-list a, .footer__link-button { color: inherit; text-decoration: none; background: none; border: 0; font: inherit; padding: 0; text-align: start; cursor: pointer; }
  .footer__link-list a:hover, .footer__link-button:hover { color: var(--accent-soft); }

  .footer__about { display: flex; flex-direction: column; gap: var(--space-sm); margin-block-start: var(--space-sm); }
  .footer__logo { max-width: 13rem; max-height: 3.4rem; width: auto; height: auto; object-fit: contain; object-position: left center; }
  .footer__logo-text { font-weight: 700; font-size: 1.1rem; color: var(--footer-heading); }
  .footer__about-text { margin: 0; font-size: var(--font-size-sm); opacity: 0.85; line-height: 1.5; }
  .footer__about .footer__link-list { margin-block-start: 0; }

  .footer__social-icons { display: flex; flex-wrap: wrap; gap: var(--space-sm); }
  .footer__social-icon { color: inherit; display: inline-flex; font-size: 1.4rem; opacity: 0.85; }
  .footer__social-icon:hover { opacity: 1; }

  /* Extra bottom padding so the last line clears the fixed widgets (UserWay,
     reviews pill; on ≤900px the callbar) — agency rule. */
  .footer__bottom { inline-size: min(var(--container-max), 100% - 2.5rem); margin-inline: auto; padding: var(--space-lg) 0 calc(var(--space-lg) + 4.5rem); margin-block-start: var(--space-lg); border-block-start: 1px solid var(--footer-border); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-sm); font-size: var(--font-size-sm); }
  .footer__signature { color: inherit; opacity: 0.8; text-decoration: none; }
  .footer__signature:hover { color: var(--accent-soft); opacity: 1; }

  @media (min-width: 900px) {
    /* The column dividers only separate the accordion on phones. */
    .footer__column { border-block-end: 0; }
    .footer__column summary { pointer-events: none; }
    .footer__column summary::marker,
    .footer__column summary::-webkit-details-marker { display: none; content: ""; }
  }

  @media (max-width: 1100px) and (min-width: 900px) {
    .footer__grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 899px) {
    .footer__grid { grid-template-columns: 1fr; gap: var(--space-sm); }
    .footer__column-title { cursor: pointer; }
    .footer__bottom { padding-block-end: calc(var(--callbar-height) + 4.5rem); }
  }
</style>
