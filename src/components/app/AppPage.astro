---
// PetPage app page (Pastel 4wq5nl74 #6, 2026-11-25): the header's "Download
// Our App!" button leads here; both store links. Intro text is the current
// site's PetPage App section word for word (home page), translated on /es/.
import PageHeaderBanner from "../PageHeaderBanner.astro";
import CtaBand from "../CtaBand.astro";
import { type Lang, PETPAGE_IOS_URL, PETPAGE_ANDROID_URL } from "../../data/i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const es = lang === "es";
const c = es
  ? {
      heading: "Descargue Nuestra App",
      eyebrow: "App PetPage",
      title: "Su mascota, en su teléfono",
      intro: "PetPage le facilita mantenerse al tanto de la salud de su mascota, con herramientas fáciles de usar que lo mantienen conectado con su veterinario y con la salud de su mascota las 24 horas del día, los 7 días de la semana.",
      email: "Al registrarse, use el correo electrónico que tenemos en nuestros archivos.",
      iosSmall: "Descárguela en el",
      androidSmall: "Disponible en",
      cta: { heading: "¿Listo para agendar", accent: "su visita?", text: "Agende en línea en minutos o llámenos, con gusto le ayudamos." },
    }
  : {
      heading: "Download Our App",
      eyebrow: "PetPage App",
      title: "Your pet’s care, in your pocket",
      intro: "PetPage makes it easy to stay connected with your pet’s health and features easy-to-use, self-serve tools keeping you connected to your veterinarian and your pet’s health 24/7.",
      email: "Please use the email address you have on file with our office when signing up.",
      iosSmall: "Download on the",
      androidSmall: "Get it on",
      cta: { heading: "Ready to book", accent: "your visit?", text: "Book online in minutes or give us a call — we’re happy to help." },
    };
---

<PageHeaderBanner heading={c.heading} eyebrow={c.eyebrow} />

<section class="app-sec">
  <div class="app-card" data-reveal>
    <h2 class="app-card__title">{c.title}</h2>
    <p class="app-card__intro">{c.intro}</p>
    <p class="app-card__note">{c.email}</p>
    <ul class="app-stores" role="list">
      <li>
        <a class="app-store" href={PETPAGE_IOS_URL} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16.37 12.6c-.02-2.3 1.88-3.4 1.96-3.46a4.2 4.2 0 0 0-3.3-1.79c-1.4-.14-2.74.83-3.45.83-.71 0-1.8-.81-2.97-.79a4.4 4.4 0 0 0-3.72 2.26c-1.6 2.77-.41 6.86 1.14 9.1.76 1.1 1.66 2.33 2.84 2.29 1.14-.05 1.57-.74 2.95-.74 1.37 0 1.76.74 2.96.71 1.23-.02 2-1.11 2.75-2.22a9.8 9.8 0 0 0 1.25-2.56 3.96 3.96 0 0 1-2.4-3.63zM14.1 5.86A3.94 3.94 0 0 0 15.03 3a4 4 0 0 0-2.6 1.34 3.75 3.75 0 0 0-.95 2.76 3.32 3.32 0 0 0 2.62-1.24z"/></svg>
          <span><small>{c.iosSmall}</small><b>App Store</b></span>
        </a>
      </li>
      <li>
        <a class="app-store" href={PETPAGE_ANDROID_URL} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.2 2.6c-.3.3-.45.75-.45 1.3v16.2c0 .55.15 1 .45 1.3l.07.06L13.3 12.4v-.2L4.27 2.54zM16.3 15.4l-3-3v-.2l3-3 .07.04 3.56 2.02c1.02.58 1.02 1.52 0 2.1l-3.56 2.02zM16.37 15.36 13.3 12.3l-9.1 9.1c.34.36.9.4 1.52.05l10.65-6.1M16.37 9.24 5.72 3.15c-.62-.36-1.18-.31-1.52.05l9.1 9.1z"/></svg>
          <span><small>{c.androidSmall}</small><b>Google Play</b></span>
        </a>
      </li>
    </ul>
  </div>
</section>

<CtaBand heading={c.cta.heading} accent={c.cta.accent} text={c.cta.text} />

<style>
  .app-sec { padding-block: 5rem; }
  .app-card { inline-size: min(48rem, 100% - 2.5rem); margin-inline: auto; background: var(--white); border: 1px solid var(--light-grey); border-radius: var(--radius-xl); padding: 3rem; text-align: center; }
  .app-card__title { margin: 0 0 var(--space-md); font-size: var(--font-size-section); }
  .app-card__intro { margin: 0 auto var(--space-md); max-inline-size: 38rem; font-size: 1.1rem; }
  .app-card__note { margin: 0 auto var(--space-xl); font-weight: 700; color: var(--main); }
  .app-stores { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem; }
  .app-store { display: inline-flex; align-items: center; gap: 0.75rem; min-inline-size: 13rem; padding: 0.8rem 1.5rem; border-radius: var(--radius-lg); background: var(--main); color: var(--white); text-align: start; transition: background-color var(--motion-duration-base) var(--motion-ease); }
  .app-store:hover { background: var(--cta); color: var(--white); }
  .app-store svg { inline-size: 2rem; block-size: 2rem; fill: currentColor; flex-shrink: 0; }
  .app-store small { display: block; font-size: 0.78rem; opacity: 0.85; }
  .app-store b { display: block; font-size: 1.3rem; line-height: 1.15; }
  @media (max-width: 600px) { .app-sec { padding-block: 3.5rem; } .app-card { padding: 1.75rem 1.25rem; } .app-store { inline-size: 100%; } .app-stores li { inline-size: 100%; } }
</style>
