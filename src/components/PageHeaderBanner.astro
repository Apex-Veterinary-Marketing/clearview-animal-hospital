---
// Inner-page banner — Clearview V3b look (2026-11-17): the homepage hero,
// shorter. A photo under a navy scrim (dark on the text side), left-aligned
// eyebrow + white h1 with an optional italic accent word, optional lede.
// Without a photo it's a navy panel with the light paw pattern. The bottom
// edge fades into the page's warm cream so the first section flows on.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Props {
  heading: string;
  /** Italic serif words after the heading (homepage style), e.g. "close to home". */
  accent?: string;
  eyebrow?: string;
  lede?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  /** object-position for the photo, e.g. "50% 30%" — keep pets' faces in frame. */
  imagePosition?: string;
}
const { heading, accent, eyebrow, lede, image, imageAlt = "", imagePosition = "50% 40%" } = Astro.props;
---

<div class:list={["page-banner", !image && "page-banner--plain paws paws--light"]}>
  {image && (
    <Image src={image} alt={imageAlt} class="page-banner__image" widths={[640, 960, 1440, 1920]} sizes="100vw" loading="eager" fetchpriority="high" style={`object-position: ${imagePosition}`} />
  )}
  <div class="page-banner__content">
    {eyebrow && <p class="eyebrow page-banner__eyebrow">{eyebrow}</p>}
    <h1 class="page-banner__heading">{heading}{accent && <> <span class="accent">{accent}</span></>}</h1>
    {lede && <p class="page-banner__lede">{lede}</p>}
    <slot />
  </div>
</div>

<style>
  /* Pads by --header-height: the fixed header sits over the top of the banner. */
  .page-banner { position: relative; isolation: isolate; display: flex; align-items: flex-end; min-block-size: var(--page-header-height); padding: calc(var(--header-height) + 4rem) 0 3.5rem; background: var(--main-dark); color: var(--white); overflow: hidden; }
  .page-banner__image { position: absolute; inset: 0; z-index: -2; inline-size: 100%; block-size: 100%; object-fit: cover; }
  .page-banner::after { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, var(--hero-scrim) 0%, var(--hero-scrim-mid) 45%, var(--hero-scrim-light) 80%, var(--dark-transparent) 100%); }
  .page-banner--plain { background: var(--main); }
  .page-banner--plain::after { display: none; }
  .page-banner__content { inline-size: min(var(--container-max), 100% - 2.5rem); margin-inline: auto; }
  .page-banner__content > * { max-inline-size: 44rem; }
  .page-banner__eyebrow { color: var(--accent-soft); }
  .page-banner__heading { margin: 0; color: inherit; font-size: var(--font-size-page-title); }
  .page-banner__heading .accent { color: var(--accent-soft); }
  .page-banner__lede { margin: var(--space-lg) 0 0; font-size: 1.15rem; color: var(--white-o85); }

  @media (max-width: 900px) {
    .page-banner { padding-block: calc(var(--header-height) + 3rem) 2.5rem; min-block-size: 0; }
    .page-banner::after { background: linear-gradient(90deg, var(--hero-scrim) 0%, var(--hero-scrim-mid) 100%); }
  }
</style>
