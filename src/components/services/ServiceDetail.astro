---
// Service page body — Clearview V3b (2026-11-17), shared by the English route
// (src/pages/services/[slug].astro) and the Spanish one
// (src/pages/es/servicios-veterinarios/[slug].astro).
//
// Agency standard: 3 text + image blocks (image FULL WIDTH under its text,
// never beside it; height capped at 34rem), then the "cta" block (navy card
// with the booking + phone buttons), then 5 FAQs. A sticky sidebar lists the
// other services by category, and the page ends with the CTA band.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import PageHeaderBanner from "../PageHeaderBanner.astro";
import FaqAccordion from "../FaqAccordion.astro";
import CtaBand from "../CtaBand.astro";
import ServicesSidebar from "../ServicesSidebar.astro";
import { getSiteInfo } from "../../lib/data/site";
import { phoneHref } from "../../lib/utils/phone";
import type { Lang } from "../../data/i18n";

export interface Props {
  lang: Lang;
  heading: string;
  categoryName?: string;
  categoryId?: string;
  serviceId: string; // English service id (sidebar highlight)
  headerImage?: ImageMetadata;
  headerPosition?: string;
  blocks: { body: string; image?: ImageMetadata; style: "default" | "cta" }[];
  faqs: { question: string; answer: string }[];
}
const { lang, heading, categoryName, categoryId, serviceId, headerImage, headerPosition, blocks, faqs } = Astro.props;
const site = await getSiteInfo();
const es = lang === "es";
const bookHref = site.bookingUrl || "/contact-us";
const arrow = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
---

<PageHeaderBanner heading={heading} eyebrow={categoryName} image={headerImage} imageAlt="" imagePosition={headerPosition} />

<div class="svc-page">
  <div class="svc-page__main">
    {blocks.map((block) =>
      block.style === "cta" ? (
        <div class="svc-cta paws paws--light" data-reveal>
          <div class="svc-cta__body svc-rt" set:html={block.body} />
          <div class="svc-cta__actions">
            <a class="btn btn--cta" href={bookHref} target="_blank" rel="noopener">{es ? "Solicitar una Cita" : "Book an Appointment"} <Fragment set:html={arrow} /></a>
            {site.phoneNumber && <a class="btn btn--line-light" href={phoneHref(site)}>{es ? "Llamar al" : "Call"} <span class="nowrap">{site.phoneNumber}</span></a>}
          </div>
        </div>
      ) : (
        <section class="svc-block" data-reveal>
          <div class="svc-block__body svc-rt" set:html={block.body} />
          {block.image && (
            <Image class="svc-block__image" src={block.image} alt="" widths={[640, 960, 1280, 1600]} sizes="(max-width: 900px) 100vw, 56rem" />
          )}
        </section>
      )
    )}

    {faqs.length > 0 && (
      <div class="svc-page__faqs" data-reveal>
        <FaqAccordion faqs={faqs} eyebrow={es ? "Preguntas Frecuentes" : "FAQs"} heading={es ? `${heading}: preguntas frecuentes` : `${heading}: Frequently Asked Questions`} />
      </div>
    )}
  </div>

  <aside class="svc-page__aside">
    <ServicesSidebar lang={lang} activeCategoryId={categoryId} activeServiceId={serviceId} />
  </aside>
</div>

<CtaBand lang={lang} heading={es ? "¿Listo para agendar" : "Ready to book"} accent={es ? "su visita?" : "your visit?"} text={es ? "Agende en línea en minutos o llámenos; con gusto le ayudamos." : "Book online in minutes or give us a call — we’re happy to help."} />

<style>
  .nowrap { white-space: nowrap; }
  .svc-page { inline-size: min(var(--container-max), 100% - 2.5rem); margin-inline: auto; padding-block: 4.5rem 5rem; display: grid; grid-template-columns: minmax(0, 1fr) 18rem; gap: 4rem; align-items: start; }
  .svc-page__main { display: flex; flex-direction: column; gap: 3.5rem; min-inline-size: 0; }
  .svc-page__aside { position: sticky; inset-block-start: calc(var(--header-height) + var(--space-lg)); }

  .svc-block { display: flex; flex-direction: column; gap: var(--space-lg); }
  .svc-block :global(.svc-block__image) { inline-size: 100%; block-size: auto; max-block-size: 34rem; object-fit: cover; border-radius: var(--radius-xl); }

  .svc-rt :global(h2) { margin: 0 0 var(--space-md); }
  .svc-rt :global(h3) { margin: var(--space-lg) 0 var(--space-sm); color: var(--main); }
  .svc-rt :global(p) { margin: 0 0 var(--space-md); font-size: 1.05rem; }
  .svc-rt :global(ul) { margin: 0 0 var(--space-md); padding-inline-start: 1.2rem; }
  .svc-rt :global(li) { margin-block-end: var(--space-xs); }
  .svc-rt :global(li::marker) { color: var(--cta); }
  .svc-rt :global(h2 + p:last-child) { margin-block-end: 0; }
  .svc-rt > :global(:last-child) { margin-block-end: 0; }

  .svc-cta { background: var(--main); color: var(--white); border-radius: var(--radius-xl); padding: 2.5rem; }
  .svc-cta :global(h2) { color: var(--white); }
  .svc-cta :global(p) { color: var(--on-dark-muted); }
  .svc-cta :global(a:not(.btn)) { color: var(--white); }
  .svc-cta__actions { display: flex; flex-wrap: wrap; gap: var(--space-sm); margin-block-start: var(--space-lg); }
  .svc-cta :global(.btn--cta), .svc-cta :global(.btn--cta:hover) { color: var(--on-cta); }
  .svc-cta :global(.btn--line-light:hover) { color: var(--main); }

  @media (max-width: 900px) {
    .svc-page { grid-template-columns: 1fr; gap: 3rem; padding-block: 3rem 4rem; }
    .svc-page__aside { position: static; }
    .svc-cta { padding: 1.75rem; }
  }
</style>
