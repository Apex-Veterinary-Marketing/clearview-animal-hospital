---
// "Other services" sidebar on every service page. One collapsible <details>
// group per service category (native, zero JS); the current page's category
// starts open and the current service is shown highlighted, not linked.
// Respects services.showOnSidebarMenu. Clearview V3b look (2026-11-17): a
// white card; on Spanish pages the names and links point to the /es/ pages.
import { getAllServiceCategories } from "../lib/data/serviceCategories";
import { getServicesByCategory } from "../lib/data/services";
import { getAllServicesEs, getEsSlugMap, ES_SERVICES_BASE } from "../lib/data/servicesEs";
import { type Lang, serviceCategoryEs } from "../data/i18n";

export interface Props {
  activeCategoryId?: string;
  activeServiceId?: string; // English service id
  lang?: Lang;
}
const { activeCategoryId, activeServiceId, lang = "en" } = Astro.props;
const es = lang === "es";

const categories = await getAllServiceCategories();
const esSlugs = es ? await getEsSlugMap() : {};
const esNames = es ? Object.fromEntries((await getAllServicesEs()).map((s) => [s.data.enSlug, s.data.name])) : {};
const groups = (
  await Promise.all(
    categories.map(async (category) => ({
      category,
      name: es ? serviceCategoryEs[category.id] ?? category.data.name : category.data.name,
      services: (await getServicesByCategory(category.id))
        .filter((service) => service.data.showOnSidebarMenu)
        .map((service) => ({
          id: service.id,
          name: es ? esNames[service.id] ?? service.data.customName ?? service.data.name : service.data.customName || service.data.name,
          href: es && esSlugs[service.id] ? `${ES_SERVICES_BASE}/${esSlugs[service.id]}/` : `/services/${service.id}`,
        })),
    }))
  )
).filter((group) => group.services.length > 0);
---

<nav class="services-sidebar" aria-label={es ? "Otros servicios" : "Other services"}>
  <p class="services-sidebar__heading">{es ? "Nuestros Servicios" : "Our Services"}</p>
  {groups.map((group) => (
    <details class="services-sidebar__group" open={group.category.id === activeCategoryId}>
      <summary class="services-sidebar__group-title">{group.name}<i aria-hidden="true"></i></summary>
      <ul class="services-sidebar__list">
        {group.services.map((service) => (
          <li>
            {service.id === activeServiceId ? (
              <span class="services-sidebar__current" aria-current="page">{service.name}</span>
            ) : (
              <a href={service.href}>{service.name}</a>
            )}
          </li>
        ))}
      </ul>
    </details>
  ))}
  <a class="services-sidebar__all-link" href={es ? `${ES_SERVICES_BASE}/` : "/services"}>{es ? "Todos los Servicios" : "All Services"} →</a>
</nav>

<style>
  .services-sidebar { background: var(--white); border: 1px solid var(--light-grey); border-radius: var(--radius-xl); padding: var(--space-lg); }
  .services-sidebar__heading { margin: 0 0 var(--space-sm); font-family: var(--font-accent); font-style: italic; font-size: 1.6rem; line-height: 1.1; color: var(--main); }
  .services-sidebar__group { border-block-start: 1px solid var(--light-grey); }
  .services-sidebar__group-title { display: flex; align-items: center; justify-content: space-between; gap: var(--space-xs); padding-block: var(--space-sm); cursor: pointer; font-weight: 700; color: var(--main); list-style: none; }
  .services-sidebar__group-title::-webkit-details-marker { display: none; }
  .services-sidebar__group-title i { flex-shrink: 0; inline-size: 0.45em; block-size: 0.45em; border-inline-end: 2px solid var(--cta); border-block-end: 2px solid var(--cta); transform: rotate(45deg); margin-block-start: -0.2em; transition: transform var(--motion-duration-base) var(--motion-ease); }
  .services-sidebar__group[open] .services-sidebar__group-title i { transform: rotate(225deg); margin-block-start: 0.2em; }
  .services-sidebar__list { list-style: none; margin: 0 0 var(--space-sm); padding: 0; display: flex; flex-direction: column; gap: var(--space-xs); }
  .services-sidebar__list a { color: var(--text); font-size: 0.95rem; }
  .services-sidebar__list a:hover { color: var(--cta); }
  .services-sidebar__current { font-size: 0.95rem; font-weight: 700; color: var(--cta); }
  .services-sidebar__all-link { display: inline-block; margin-block-start: var(--space-sm); font-weight: 700; color: var(--cta); }
  .services-sidebar__all-link:hover { color: var(--cta-hover); }
</style>
