---
// Blog card — Clearview V3b (2026-11-17): white card, rounded photo, date
// (UTC, so a YYYY-MM-DD pubDate never shifts a day), title, summary, link.
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { postHref } from "../lib/data/blog";

export interface Props {
  post: CollectionEntry<"blog">;
}
const { post } = Astro.props;
const date = post.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
---

<a class="blog-card" href={postHref(post)}>
  {post.data.postThumbnail && <Image src={post.data.postThumbnail} alt={post.data.thumbnailAlt || ""} class="blog-card__image" widths={[400, 640, 800]} sizes="(max-width: 767px) 100vw, 380px" />}
  <div class="blog-card__body">
    <span class="blog-card__date">{post.data.monthLabel || date}</span>
    <h3 class="blog-card__heading">{post.data.name}</h3>
    {post.data.postSummary && <p class="blog-card__summary">{post.data.postSummary}</p>}
    <span class="blog-card__cta">Read More →</span>
  </div>
</a>

<style>
  .blog-card { display: flex; flex-direction: column; block-size: 100%; color: var(--text); background: var(--white); border: 1px solid var(--light-grey); border-radius: var(--radius-xl); overflow: hidden; transition: border-color var(--motion-duration-base) var(--motion-ease), box-shadow var(--motion-duration-base) var(--motion-ease); }
  .blog-card:hover { color: var(--text); border-color: var(--main); box-shadow: var(--shadow-dropdown); }
  .blog-card__image { inline-size: 100%; aspect-ratio: 16 / 10; object-fit: cover; }
  .blog-card__body { padding: var(--space-lg); display: flex; flex-direction: column; gap: var(--space-xs); flex: 1; }
  .blog-card__date { font-family: var(--font-accent); font-style: italic; font-size: 1.1rem; color: var(--cta); }
  .blog-card__heading { margin: 0; font-size: 1.3rem; color: var(--main); transition: color var(--motion-duration-base) var(--motion-ease); }
  .blog-card:hover .blog-card__heading { color: var(--cta); }
  .blog-card__summary { margin: 0; color: var(--text-muted); font-size: 0.95rem; flex: 1; }
  .blog-card__cta { margin-block-start: var(--space-xs); font-weight: 700; color: var(--cta); }
</style>
