---
// FAQs — Clearview V3b (2026-11-17). A "Visiting Clearview" group first
// (answers built only from facts on the client's own site: booking, same-day
// visits, emergencies, payment, refills, late arrivals, spay/neuter clinic).
// 2026-11-19: the per-service FAQ groups were removed (user: keep only the
// general questions; the old clearvieweasley.com had no FAQ page). Service
// FAQs stay on each service page.
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeaderBanner from "../components/PageHeaderBanner.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import CtaBand from "../components/CtaBand.astro";
import { getSiteInfo } from "../lib/data/site";
import { phoneHref } from "../lib/utils/phone";
import { stripHtml } from "../lib/utils/stripHtml";

const site = await getSiteInfo();
const tel = phoneHref(site);
const book = site.bookingUrl || "/contact-us";

const general = [
  { question: "Are you accepting new patients?", answer: `<p>Yes! Clearview Animal Hospital is accepting new patients. You can <a href="${book}">book online</a> in minutes or call us at <a href="${tel}">${site.phoneNumber}</a>.</p>` },
  { question: "Do you offer same-day appointments?", answer: `<p>Yes, we have same-day appointments available. Call us at <a href="${tel}">${site.phoneNumber}</a> and we’ll do our best to see your pet quickly.</p>` },
  { question: "What should I do if my pet has an emergency?", answer: `<p>If your pet is experiencing a medical emergency, don’t delay, please call for immediate assistance or proceed to the nearest veterinary emergency center.</p>${site.afterHours ?? ""}` },
  { question: "What kinds of pets do you see?", answer: "<p>While we love all creatures great and small, we focus on four-legged friends, so if they have fur, we’re here to help!</p>" },
  { question: "What payment options do you offer?", answer: `<p>We accept cash and credit cards, and we offer payment plans through Cherry and CareCredit, which provide ways to get help with vet bills so your pet can get the care they need. See our <a href="/payment-plans">Payment Plans</a> page to learn more.</p>` },
  { question: "Do you accept pet insurance?", answer: "<p>We don’t bill pet insurance companies directly, but we’ll gladly provide the documentation you need to submit a claim to your insurer for reimbursement.</p>" },
  { question: "What are your hours?", answer: "<p>We’re open Monday, Tuesday, Thursday and Friday from 9:00am to 5:00pm, and Wednesday from 9:00am to 1:00pm. We’re closed Saturday and Sunday. You’ll find us at 6714 Calhoun Memorial Highway in Easley, across from Home Depot.</p>" },
  { question: "How do I request a prescription refill?", answer: `<p>Send us an <a href="https://practices.allydvm.com/product-request?practice=clearviewanimal">Rx Refill Request</a> online, no phone call needed. You can also order food and medications for delivery from our <a href="https://clearvieweasley.vetsfirstchoice.com/">online pharmacy</a>.</p>` },
  { question: "What happens if I’m running late for my appointment?", answer: "<p>An appointment is forfeited if an owner arrives more than 30 min after their scheduled apt time without calling. If you’re running late, please give us a call.</p>" },
  { question: "Do you offer low-cost spay and neuter?", answer: `<p>Yes, we offer discounted spay and neuter surgery for dogs 5 years of age or younger. See our <a href="/low-cost-spay-neuter-clinic">Low Cost Spay &amp; Neuter Clinic</a> page for prices and requirements.</p>` },
];

const graph = [
  {
    "@type": "FAQPage",
    "@id": "#faq",
    mainEntity: general.map((f) => ({
      "@type": "Question",
      name: f.question,
      acceptedAnswer: { "@type": "Answer", text: stripHtml(f.answer) },
    })),
  },
];
---

<BaseLayout title="Pet Care FAQs | Clearview Animal Hospital, Easley SC" titleTemplate="full" breadcrumb="FAQs" description="Answers to common questions about visits, payments, prescriptions and pet care at Clearview Animal Hospital, serving Easley, SC and the Upstate since 1958." schemaGraph={graph}>
  <PageHeaderBanner heading="Frequently Asked" accent="Questions" eyebrow="FAQs" lede="Answers to common questions about visits, payments, prescriptions and pet care." />

  <div class="faq-page">
    <section class="faq-page__group" id="visiting" data-reveal>
      <FaqAccordion faqs={general} heading="Visiting Clearview" />
    </section>
  </div>

  <CtaBand heading="Still have" accent="questions?" text={`Call us at ${site.phoneNumber}, we’re happy to help.`} />
</BaseLayout>

<style>
  .faq-page { inline-size: min(52rem, 100% - 2.5rem); margin-inline: auto; padding-block: 4rem 5rem; display: flex; flex-direction: column; gap: 3.5rem; }
  .faq-page__group { scroll-margin-block-start: calc(var(--header-height) + var(--space-lg)); }
</style>
