---
// Gets a PageHeaderBanner like every other page (2026-09-08) — not just for
// consistency, the sitewide header relies on a dark hero/banner behind it
// to render its default transparent+white-text state legibly; a page with
// no banner would show transparent-white nav text over a plain white body.
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeaderBanner from "../components/PageHeaderBanner.astro";
---

<BaseLayout title="Page Not Found" noindex>
  <PageHeaderBanner heading="Page not found" eyebrow="404" />
  <div class="not-found">
    <p>Sorry, we couldn't find that page. It may have moved when our new website launched.</p>
    <p class="not-found__links"><a class="btn btn--cta" href="/">Back to Home</a> <a class="btn btn--line" href="/services">Our Services</a> <a class="btn btn--line" href="/contact-us">Contact Us</a></p>
  </div>
</BaseLayout>

<style>
  .not-found { inline-size: min(40rem, 100% - 2.5rem); margin-inline: auto; padding-block: 4.5rem 5rem; text-align: center; font-size: 1.1rem; }
  .not-found__links { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-sm); margin-block-start: var(--space-lg); }
</style>
