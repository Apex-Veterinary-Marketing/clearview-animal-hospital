---
// Privacy Policy — the client's own policy (theirs always replaces the
// template default), word for word from their current site; the old page
// title was "Privacy Policy and Terms of Use", so /terms-of-use now
// redirects here (public/_redirects). Text: src/data/legal/privacy-policy.en.md.
import BaseLayout from "../layouts/BaseLayout.astro";
import LegalPage from "../components/LegalPage.astro";
import { Content } from "../data/legal/privacy-policy.en.md";
---

<BaseLayout title="Privacy Policy - Clearview Animal Hospital" titleTemplate="full" breadcrumb="Privacy Policy" description="Learn how Clearview Animal Hospital in Easley, SC collects, uses and protects the personal information you share with us through this website and our services." altLangPath="/es/poliza-de-privacidad/">
  <LegalPage heading="Privacy Policy and Terms of Use" eyebrow="Legal"><Content /></LegalPage>
</BaseLayout>
