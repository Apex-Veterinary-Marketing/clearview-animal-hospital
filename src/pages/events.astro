---
// Events (old URL kept; old page had no meta description — this one is new).
// Event copy is word for word from the old page. Events live in
// src/data/events.ts and move from "Upcoming" to "Past" on their own once
// they end (Pastel 4wq5nl74 #9, 2026-11-25): sorted at build time, then
// re-checked in the browser so it stays right between rebuilds.
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeaderBanner from "../components/PageHeaderBanner.astro";
import CtaBand from "../components/CtaBand.astro";
import { events, eventEnds, eventWhen } from "../data/events";

const now = Date.now();
const all = events
  .map((e) => ({ ...e, ends: eventEnds(e), when: eventWhen(e) }))
  .sort((a, b) => a.ends.localeCompare(b.ends));
const upcoming = all.filter((e) => Date.parse(e.ends) > now);
const past = all.filter((e) => Date.parse(e.ends) <= now).reverse();
---

<BaseLayout title="Events - Clearview Animal Hospital" titleTemplate="full" breadcrumb="Events" description="Community events from Clearview Animal Hospital in Easley, SC, like our low-cost canine vaccine and microchip clinic with the Pickens Fire Department.">
  <PageHeaderBanner heading="Events" eyebrow="In the community" />

  <div class="ev-page">
  {[
    { key: "upcoming", heading: "Upcoming Events", list: upcoming, empty: "No upcoming events right now. Check back soon!" },
    { key: "past", heading: "Past Events", list: past, empty: "" },
  ].map((group) => (
    <section class={`ev-sec ev-sec--${group.key}`} data-events={group.key} hidden={group.key === "past" && !group.list.length}>
      <div class="ev-wrap">
        <h2 class="ev-sec__title">{group.heading}</h2>
        {group.empty && <p class="ev-empty" data-events-empty hidden={group.list.length > 0}>{group.empty}</p>}
        <div class="ev-list" data-events-list>
          {group.list.map((e) => (
            <article class="ev-card" data-ends={e.ends} data-reveal>
              {e.image && <Image class="ev-card__img" src={e.image} alt={e.imageAlt ?? ""} widths={[640, 960, 1280]} sizes="(max-width: 900px) 100vw, 34rem" />}
              <div class="ev-card__body">
                <h3 class="ev-card__title">{e.title}</h3>
                {e.subtitle && <p class="ev-card__sub">{e.subtitle}</p>}
                <p class="ev-card__meta">{e.when}</p>
                {e.location && <p class="ev-card__meta">{e.location}</p>}
                {e.paragraphs.map((p) => <p>{p}</p>)}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}
  </div>

  <CtaBand heading="Ready to book" accent="your visit?" text="Book online in minutes or give us a call — we’re happy to help." />
</BaseLayout>

<script>
  // Move any event that has ended since the last build into Past Events
  // (most recent first) and update the empty states.
  const up = document.querySelector<HTMLElement>('[data-events="upcoming"]');
  const past = document.querySelector<HTMLElement>('[data-events="past"]');
  const upList = up?.querySelector<HTMLElement>("[data-events-list]");
  const pastList = past?.querySelector<HTMLElement>("[data-events-list]");
  if (up && past && upList && pastList) {
    const now = Date.now();
    const ended = [...upList.querySelectorAll<HTMLElement>("[data-ends]")].filter((el) => Date.parse(el.dataset.ends || "") <= now);
    for (const el of ended.reverse()) pastList.prepend(el);
    const empty = up.querySelector<HTMLElement>("[data-events-empty]");
    if (empty) empty.hidden = upList.children.length > 0;
    past.hidden = pastList.children.length === 0;
  }
</script>

<style>
  .ev-page { padding-block-end: 5rem; overflow-x: clip; }
  .ev-sec { padding-block-start: 5rem; }
  .ev-sec[hidden] { display: none; }
  .ev-wrap { inline-size: min(var(--container-max), 100% - 2.5rem); margin-inline: auto; }
  .ev-sec__title { margin: 0 0 var(--space-lg); font-size: var(--font-size-section); }
  .ev-empty { margin: 0; font-size: 1.08rem; }
  .ev-list { display: grid; gap: 2rem; }
  .ev-card { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; background: var(--white); border: 1px solid var(--light-grey); border-radius: var(--radius-xl); padding: 2rem; }
  .ev-card :global(.ev-card__img) { inline-size: 100%; block-size: auto; border-radius: var(--radius-lg); }
  .ev-card__title { margin: 0 0 var(--space-xs); font-size: 2rem; }
  .ev-card__sub { margin: 0 0 var(--space-md); font-family: var(--font-accent); font-style: italic; font-weight: 400; font-size: 1.6rem; color: var(--cta); }
  .ev-card__meta { margin: 0 0 var(--space-2xs); font-weight: 700; color: var(--main); }
  .ev-card__meta + p:not(.ev-card__meta) { margin-block-start: var(--space-md); }
  .ev-card p { margin: 0 0 var(--space-md); }
  @media (max-width: 900px) { .ev-page { padding-block-end: 3.5rem; } .ev-sec { padding-block-start: 3.5rem; } .ev-card { grid-template-columns: 1fr; gap: 1.5rem; padding: 1.25rem; } }
</style>
