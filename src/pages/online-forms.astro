---
// Generic forms hub — no dedicated "forms list" collection exists in
// Skeleton's content model, so this ships as a single-form placeholder
// page (New Patient Form) an AI/dev extends with more embeds per client
// as needed. See Skeleton-Build-Spec.md §8.
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeaderBanner from "../components/PageHeaderBanner.astro";
import GravityFormEmbed from "../components/GravityFormEmbed.astro";
---

<BaseLayout title="Online Pet Forms | Clearview Animal Hospital, Easley SC" titleTemplate="full" breadcrumb="Online Forms" description="Fill out new patient and other forms for Clearview Animal Hospital online before your visit, so your appointment in Easley, SC can start right on time.">
  <PageHeaderBanner heading="Online Forms" eyebrow="Before your visit" lede="Fill out your forms ahead of time so your appointment can start right on time." />
  <div class="page-section">
    <GravityFormEmbed formId="new-patient" context="general-info" heading="New Patient Form" />
  </div>
</BaseLayout>

<style>
  .page-section { inline-size: min(44rem, 100% - 2.5rem); margin-inline: auto; margin-block: 4.5rem 5rem; background: var(--white); border: 1px solid var(--light-grey); border-radius: var(--radius-xl); padding: 2.5rem; }
  @media (max-width: 767px) { .page-section { padding: 1.5rem; } }
</style>
